{
  "name": "Atlas",
  "image": "mcr.microsoft.com/devcontainers/python:3.12",
  "postCreateCommand": "cd backend && python -m venv .venv && .venv/bin/pip install --upgrade pip && .venv/bin/pip install -r requirements-dev.txt",
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {
      "label": "Backend Atlas",
      "visibility": "private"
    }
  },
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"],
      "settings": {
        "python.defaultInterpreterPath": "${containerWorkspaceFolder}/backend/.venv/bin/python",
        "python.testing.pytestEnabled": true,
        "python.testing.pytestArgs": ["backend/tests"]
      }
    }
  }
}
