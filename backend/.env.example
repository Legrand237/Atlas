# Atlas — exemple de configuration (étapes 1-2)
#
# Pour l'utiliser : copie ce fichier en ".env" dans le dossier backend/
#   cp .env.example .env
# Le fichier ".env" est ignoré par Git (voir .gitignore) : il ne sera jamais envoyé sur GitHub.
#
# CE FICHIER-CI (.env.example) EST VERSIONNÉ : n'y écris JAMAIS une vraie clé,
# un vrai mot de passe ou un vrai token. Uniquement des noms de variables et des valeurs sans danger.

# Environnement : development, test ou production
ENVIRONMENT=development

# Niveau de détail des journaux : DEBUG, INFO, WARNING, ERROR ou CRITICAL
LOG_LEVEL=INFO

# Adresse de connexion PostgreSQL (Neon). CONTIENT UN MOT DE PASSE : ne la mets que dans
# backend/.env (ignoré par Git), jamais ici. Format fourni par Neon :
#   postgresql://utilisateur:motdepasse@hote/nom_base?sslmode=require
DATABASE_URL=

# Clé secrète qui signe les tokens de connexion (au moins 32 caractères, JAMAIS écrite ici).
# Pour en générer une, dans le terminal :  python -c "import secrets; print(secrets.token_urlsafe(48))"
# puis colle le résultat après le signe = dans backend/.env (jamais dans ce fichier).
JWT_SECRET_KEY=

# Réglages optionnels de l'authentification (valeurs par défaut indiquées) :
# SESSION_DURATION_MINUTES=60
# LOGIN_MAX_FAILURES=5
# LOGIN_WINDOW_MINUTES=15
